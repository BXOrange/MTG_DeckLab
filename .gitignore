__pycache__/
*.py[cod]
*.egg-info/
node_modules/
frontend/.nodeenv/
.env
.DS_Store
venv/
venv_win/
backend/cache/
backend/data
# Local wheel cache for offline installs (setup/install.py --download-wheels).
# Platform/Python-version specific, so it's a cache, not a committed asset.
setup/wheels/

# Local bug reports contain game diagnostics and user descriptions.
/bug-reports/

# Account-database key material, encrypted backups and security logs (PLR-9e): never versioned,
# wherever MTG_DATA_DIR / MTG_ACCOUNTS_DB_KEY_FILE happens to point.
accounts.key*
*.key
accounts.db*
accounts-*.db
security.log*

# Machine-local runtime config (key-file path etc.); missing file falls back to defaults.
backend/mtg_analyzer/config.json
